<section class="alo-section loyalty-banner-section" id="loyalty-{{ section.id }}">
  <div class="loyalty-card-container">
    <div class="loyalty-content">
      <div class="loyalty-eyebrow">
        <span class="sparkle">✦</span>
        <span>EXCLUSIVE REWARDS CLUB</span>
      </div>
      <h2 class="loyalty-heading">JOIN ALO ACCESS</h2>
      <p class="loyalty-description">
        Become an insider. Earn points on every purchase, unlock private early-access color drops, and receive free classes on the Alo Moves app.
      </p>

      <div class="loyalty-perks-grid">
        <div class="perk-box">
          <span class="perk-number">1 PT / ₹100</span>
          <h4>EARN POINTS</h4>
          <p>Redeem points for store credits, exclusive gifts, and VIP gear.</p>
        </div>
        <div class="perk-box">
          <span class="perk-number">EARLY ACCESS</span>
          <h4>SECRET DROPS</h4>
          <p>Shop viral color drops before they launch to the general public.</p>
        </div>
        <div class="perk-box">
          <span class="perk-number">FREE ALO MOVES</span>
          <h4>STUDIO CLASS ACCESS</h4>
          <p>Complimentary streaming yoga, pilates, and sound bath sessions.</p>
        </div>
      </div>

      <div class="loyalty-actions">
        <a href="/account/register" class="btn-loyalty-primary">JOIN NOW FOR FREE</a>
        <a href="/account/login" class="btn-loyalty-secondary">SIGN IN TO ACCESS</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loyalty Alo Access",
  "settings": [],
  "presets": [
    {
      "name": "Loyalty Alo Access"
    }
  ]
}
{% endschema %}
