<section class="alo-section lifestyle-banner-section" id="lifestyle-{{ section.id }}">
  <div class="lifestyle-container">
    <div class="lifestyle-media-col">
      <div class="media-stack">
        <img
          src="https://images.unsplash.com/photo-1518310383802-640c2de311b2?q=80&w=1200&auto=format&fit=crop"
          alt="Studio to Street Luxury"
          class="lifestyle-primary-img"
          loading="lazy"
          width="600"
          height="750"
        >
        <div class="lifestyle-quote-badge">
          <span class="sparkle">✦</span>
          <p>"The best leggings on earth. Once you wear Airlift, nothing else compares."</p>
          <span class="attribution">— VOGUE ATHLEISURE</span>
        </div>
      </div>
    </div>

    <div class="lifestyle-content-col">
      <span class="section-eyebrow">THE ALO PHILOSOPHY</span>
      <h2 class="lifestyle-heading">MINDFUL MOVEMENT, ELEVATED LUXURY.</h2>
      <p class="lifestyle-lead">
        Alo began in Los Angeles in 2007 with a clear mission: to bring yoga to the world, inspire mindful movement, and craft the most technologically advanced, sculpting activewear on earth.
      </p>

      <div class="lifestyle-features-list">
        <div class="feature-row">
          <div class="feature-icon">01</div>
          <div class="feature-text">
            <h4>PROPRIETARY SCULPTING TECH</h4>
            <p>Our micro-performance Airlift & Airbrush knits contour, smooth, and lift with zero sheer risk.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-icon">02</div>
          <div class="feature-text">
            <h4>100% SWEATSHOP-FREE & ECO-AWARE</h4>
            <p>Certified clean, non-toxic dyeing and mindful California design principles.</p>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-icon">03</div>
          <div class="feature-text">
            <h4>STUDIO TO STREET VERSATILITY</h4>
            <p>Tailored silhouettes that transition effortlessly from morning hot yoga to dinner in the city.</p>
          </div>
        </div>
      </div>

      <div class="lifestyle-cta-row">
        <a href="/pages/fabric-guide" class="btn-dark">OUR FABRICS EXPLAINED</a>
        <button type="button" class="btn-text-link" data-open-size-guide>VIEW SIZE GUIDE →</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle Editorial",
  "settings": [],
  "presets": [
    {
      "name": "Lifestyle Editorial"
    }
  ]
}
{% endschema %}
