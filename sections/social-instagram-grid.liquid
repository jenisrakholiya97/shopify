<section class="alo-section social-grid-section" id="social-{{ section.id }}">
  <div class="section-header-centered">
    <span class="section-eyebrow">COMMUNITY & LIFESTYLE</span>
    <h2 class="section-title">AS SEEN ON @ALOYOGA</h2>
    <p class="section-subtitle">Tag @aloyoga and #aloyoga to share your studio-to-street journey with our global community.</p>
  </div>

  <div class="social-tiles-grid">
    <!-- Tile 1 -->
    <div class="social-tile">
      <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=600&auto=format&fit=crop" alt="Alo Yoga Community Look 1" loading="lazy" width="400" height="400">
      <div class="social-hover-overlay">
        <span class="ig-handle">@charlotte_yoga</span>
        <button type="button" class="btn-shop-look" data-quick-add-trigger data-product-id="alo-1">SHOP THE LOOK</button>
      </div>
    </div>

    <!-- Tile 2 -->
    <div class="social-tile">
      <img src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?q=80&w=600&auto=format&fit=crop" alt="Alo Yoga Community Look 2" loading="lazy" width="400" height="400">
