{% comment %}
  Alo Yoga signature Luxury Mega Menu Dropdown
{% endcomment %}
<div class="mega-menu-container" id="mega-menu-women" role="region" aria-label="Women Mega Menu">
  <div class="mega-menu-inner">
    <div class="mega-menu-columns">
      <!-- Column 1: Drops & Trending -->
      <div class="mega-column">
        <h4 class="column-title">WHAT'S NEW</h4>
        <ul class="mega-links-list">
          <li><a href="/collections/new-arrivals" class="highlight-link">New Arrivals</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/collections/color-drop-rich-bordeaux">The Rich Bordeaux Drop</a></li>
          <li><a href="/collections/color-drop-bamboo-trail">Bamboo Trail Edit</a></li>
          <li><a href="/collections/cashmere">The Cashmere Shop</a></li>
          <li><a href="/collections/match-sets">Matching Studio Sets</a></li>
          <li><a href="/collections/online-exclusives">Online Exclusives</a></li>
        </ul>
      </div>

      <!-- Column 2: Apparel -->
      <div class="mega-column">
        <h4 class="column-title">CLOTHING</h4>
        <ul class="mega-links-list">
          <li><a href="/collections/womens-leggings">Leggings & Tights</a></li>
          <li><a href="/collections/sports-bras">Sports Bras & Tops</a></li>
          <li><a href="/collections/sweatshirts">Sweatshirts & Hoodies</a></li>
          <li><a href="/collections/jackets">Jackets & Outerwear</a></li>
          <li><a href="/collections/trousers">Trousers & Sweatpants</a></li>
          <li><a href="/collections/shorts">Biker & Studio Shorts</a></li>
          <li><a href="/collections/dresses-skirts">Dresses & Tennis Skirts</a></li>
          <li><a href="/collections/onesies">Bodysuits & Onesies</a></li>
        </ul>
      </div>

      <!-- Column 3: Fabrics & Collections -->
      <div class="mega-column">
        <h4 class="column-title">SHOP BY FABRIC</h4>
        <ul class="mega-links-list">
          <li>
            <a href="/collections/airlift" class="fabric-link">
              <span class="fabric-name">AIRLIFT</span>
              <span class="fabric-desc">Sleek, sculpting sheen</span>
            </a>
          </li>
          <li>
            <a href="/collections/airbrush" class="fabric-link">
              <span class="fabric-name">AIRBRUSH</span>
              <span class="fabric-desc">Cottony-soft compression</span>
            </a>
          </li>
          <li>
            <a href="/collections/alosoft" class="fabric-link">
              <span class="fabric-name">ALOSOFT</span>
              <span class="fabric-desc">Ultra-velvety brushed feel</span>
            </a>
          </li>
          <li>
            <a href="/collections/accolade" class="fabric-link">
              <span class="fabric-name">ACCOLADE</span>
              <span class="fabric-desc">Heavyweight plush fleece</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Visual Editorial Cards -->
      <div class="mega-column mega-column--features">
        <div class="mega-feature-card">
          <a href="/collections/color-drop-rich-bordeaux">
            <div class="feature-img-wrap">
              <img src="https://www.aloyoga.com/cdn/shop/files/MOBILE__10.17___Rich_Bordeaux_WK1___Outerwear_1_1200x.jpg" alt="The Rich Bordeaux Drop" width="260" height="340" loading="lazy">
            </div>
            <div class="feature-info">
              <span class="feature-tag">NEW COLOR DROP</span>
              <span class="feature-title">THE RICH BORDEAUX EDIT</span>
              <span class="feature-cta">SHOP THE DROP →</span>
            </div>
          </a>
        </div>

        <div class="mega-feature-card">
          <a href="/collections/new-arrivals">
            <div class="feature-img-wrap">
              <img src="https://www.aloyoga.com/cdn/shop/files/Pink_Marshmallow_MobileCategories_01_womens_2048x2048.progressive.jpg" alt="New Season Drops" width="260" height="340" loading="lazy">
            </div>
            <div class="feature-info">
              <span class="feature-tag">STUDIO TO STREET</span>
              <span class="feature-title">NEW SEASON ESSENTIALS</span>
              <span class="feature-cta">EXPLORE COLLECTION →</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
